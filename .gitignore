# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
# Ignore migration contents but keep the directory. Note the trailing `/*`:
# ignoring `prisma/migrations/` wholesale would also exclude .gitkeep, and Git
# cannot re-include a file whose parent directory is excluded.
prisma/migrations/*
!prisma/migrations/.gitkeep
# generated Prisma Client (Prisma v7 writes it into the source tree)
/src/generated/

# storage (runtime uploads are private & ignored; seed media is versioned)
/storage/*
!/storage/seed-media/

# uploaded files (local storage variant)
/public/uploads/
