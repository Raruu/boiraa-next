# ─────────────────────────────────────────────────────────────
# APP
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=Boiraa
NODE_ENV=development

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────
# Database (Prisma v7 — the URL is read from prisma.config.ts)
# ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/boiraa?schema=public"

# ─────────────────────────────────────────────────────────────
# Auth (local JWT, no SSO)
# ─────────────────────────────────────────────────────────────
# HMAC secret for signing the at/rt tokens — generate a long random string in prod.
AUTH_JWT_SECRET="dev-only-insecure-secret-change-me"
# Demo admin created by `npm run db:seed`.
AUTH_DEMO_EMAIL="admin@demo.com"
AUTH_DEMO_PASSWORD="password"

# ─────────────────────────────────────────────────────────────
# AWS S3 (file storage — swap for local disk via the
# .agents/skills/s3-to-local-storage skill)
# ─────────────────────────────────────────────────────────────
AWS_REGION="ap-southeast-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
# AWS_ENDPOINT_URL=""  # uncomment for S3-compatible (MinIO, DigitalOcean Spaces, etc.)

# ─────────────────────────────────────────────────────────────
# QUEUE / BACKGROUND WORKER
# false (default): emails send inline, no Redis needed, no worker runs.
# true: emails go through BullMQ/Redis + background worker + recovery poller.
# ─────────────────────────────────────────────────────────────
QUEUE_ENABLED="false"

# REDIS — only used when QUEUE_ENABLED=true
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────
# SMTP
# ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_FROM=""
SMTP_SECURE=true
SMTP_FROM_NAME=
